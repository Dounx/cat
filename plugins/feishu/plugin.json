{
  "id": "feishu",
  "name": "飞书",
  "version": "0.1.0",
  "protocol": 1,
  "description": "通过飞书机器人收发单聊和群聊消息。使用长连接，不需要公网地址。",
  "command": ["./cat-plugin-feishu"],
  "capabilities": ["source", "action"],
  "setup": true,
  "config_schema": {
    "type": "object",
    "required": ["app_id", "app_secret"],
    "x-order": ["app_id", "app_secret", "domain"],
    "properties": {
      "app_id": { "type": "string", "title": "App ID", "description": "飞书开放平台 → 应用 → 凭证与基础信息。" },
      "app_secret": { "type": "string", "title": "App Secret", "format": "password" },
      "domain": {
        "type": "string",
        "title": "版本",
        "enum": ["feishu", "lark"],
        "x-enum-titles": ["飞书（feishu.cn）", "Lark（larksuite.com）"],
        "default": "feishu"
      }
    }
  },
  "events": [{ "type": "message.created", "title": "收到消息" }],
  "actions": [
    {
      "name": "reply",
      "title": "回复（原会话）",
      "description": "在触发事件所在的会话里回复。输出：message_id。",
      "params": {
        "type": "object",
        "x-order": ["text", "files", "quote", "markdown"],
        "properties": {
          "text": { "type": "string", "title": "内容", "format": "textarea" },
          "files": { "type": "string", "title": "附件（可选）", "format": "textarea", "description": "本地文件路径（每行一个），或用「插入变量」填入 {{ payload.attachments }} 直接转发收到的附件。" },
          "quote": { "type": "boolean", "title": "引用原消息", "default": true },
          "markdown": { "type": "boolean", "title": "按 Markdown 渲染", "default": true }
        }
      }
    },
    {
      "name": "send",
      "title": "发送到指定会话",
      "params": {
        "type": "object",
        "required": ["chat_id"],
        "x-order": ["chat_id", "text", "files", "markdown"],
        "properties": {
          "chat_id": { "type": "string", "title": "发到哪个会话", "x-pick": "conversation", "description": "从最近的会话里选，或直接写群的 chat_id（oc_ 开头）、用户的 open_id（ou_ 开头）。" },
          "text": { "type": "string", "title": "内容", "format": "textarea" },
          "files": { "type": "string", "title": "附件（可选）", "format": "textarea", "description": "本地文件路径（每行一个），或用「插入变量」填入 {{ payload.attachments }} 直接转发收到的附件。" },
          "markdown": { "type": "boolean", "title": "按 Markdown 渲染", "default": true }
        }
      }
    },
    { "name": "typing", "title": "显示「正在输入」", "description": "飞书不支持，此动作什么也不做，仅为与其他平台的规则保持一致。" }
  ]
}

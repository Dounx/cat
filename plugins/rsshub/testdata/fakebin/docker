#!/bin/sh
# A stand-in for the docker CLI used by the plugin's tests. A "container" is
# the fake RSSHub next to this script, listening on the published port; every
# invocation is appended to docker.log.
state="$(dirname "$0")"
echo "$*" >> "$state/docker.log"
case "$1" in
info) echo 0.0.0-fake ;;
image) [ -f "$state/pulled" ] ;;
pull) echo "Pulling $2"; touch "$state/pulled" ;;
rm)
	if [ -f "$state/$3.pid" ]; then
		kill -9 "$(cat "$state/$3.pid")" 2>/dev/null
		rm -f "$state/$3.pid"
	fi ;;
run)
	shift
	while [ $# -gt 1 ]; do
		case "$1" in
		--name) name=$2; shift 2 ;;
		-p) port=$(echo "$2" | cut -d: -f2); shift 2 ;;
		-e) shift 2 ;; # passed by name: the value is in our environment
		*) shift ;;
		esac
	done
	echo $$ > "$state/$name.pid"
	PORT="$port" FAKE_RSSHUB_LOG="$state/hub.log" exec "$state/fakersshub" ;;
*) echo "fake docker: unsupported: $*" >&2; exit 1 ;;
esac

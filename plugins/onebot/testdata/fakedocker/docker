#!/bin/sh
# A stand-in for the docker CLI used by the plugin's tests. "Containers" are
# the fake NapCat next to this script, told where its config is mounted and
# which port is published; every invocation is appended to docker.log.
# <name>.pid holds a running container's process.
state="$(dirname "$0")"
echo "$*" >> "$state/docker.log"
case "$1" in
info) echo 0.0.0-fake ;;
image) [ -f "$state/pulled" ] ;;
pull) echo "Pulling $2"; touch "$state/pulled" ;;
inspect) [ -f "$state/$4.pid" ] && kill -0 "$(cat "$state/$4.pid")" 2>/dev/null && echo true ;;
logs) exec tail -f /dev/null ;; # nothing more is printed once logged in
exec) [ -f "$state/$2.pid" ] && kill -TERM "$(cat "$state/$2.pid")" ;;
rm)
	if [ -f "$state/$3.pid" ]; then
		kill -9 "$(cat "$state/$3.pid")" 2>/dev/null
		rm -f "$state/$3.pid"
	fi ;;
run)
	shift
	while [ $# -gt 1 ]; do
		case "$1" in
		--name) name=$2; shift 2 ;;
		-p) port=$(echo "$2" | cut -d: -f2); shift 2 ;;
		-v) case "$2" in *:/app/napcat/config) cfg=${2%%:*} ;; esac; shift 2 ;;
		-e) case "$2" in ACCOUNT=*) account=${2#ACCOUNT=} ;; esac; shift 2 ;;
		*) shift ;;
		esac
	done
	# Like a real container, it outlives this client: the fake NapCat moves
	# to a session of its own and keeps going when nobody reads its output.
	FAKE_NAPCAT_DETACH=1 FAKE_NAPCAT_DIR="$(dirname "$cfg")" FAKE_NAPCAT_LISTEN="127.0.0.1:$port" \
		"$state/fakenapcat" $account &
	echo $! > "$state/$name.pid"
	wait $! ;;
*) echo "fake docker: unsupported: $*" >&2; exit 1 ;;
esac

{
  "id": "onebot",
  "name": "QQ（OneBot）",
  "version": "0.1.0",
  "protocol": 1,
  "description": "通过 OneBot 11 协议收发 QQ 消息。连接你自己运行的 OneBot 服务（正向 WebSocket）。",
  "command": ["./cat-plugin-onebot"],
  "capabilities": ["source", "action"],
  "setup": true,
  "config_schema": {
    "type": "object",
    "x-order": ["ws_url", "token"],
    "properties": {
      "ws_url": { "type": "string", "title": "WebSocket 地址", "default": "ws://127.0.0.1:3001", "description": "OneBot 正向 WebSocket 服务的地址。" },
      "token": { "type": "string", "title": "访问令牌", "format": "password" }
    }
  },
  "events": [
    { "type": "message.created", "title": "收到消息" },
    { "type": "notice", "title": "通知（入群、撤回等）" }
  ],
  "actions": [
    {
      "name": "reply",
      "title": "回复（原会话）",
      "description": "在触发事件所在的群或私聊里回复。输出：message_id。",
      "params": {
        "type": "object",
        "required": ["text"],
        "x-order": ["text", "quote"],
        "properties": {
          "text": { "type": "string", "title": "内容", "format": "textarea" },
          "quote": { "type": "boolean", "title": "引用原消息", "default": true }
        }
      }
    },
    {
      "name": "send",
      "title": "发送到指定会话",
      "params": {
        "type": "object",
        "required": ["conversation_id", "text"],
        "x-order": ["conversation_id", "text"],
        "properties": {
          "conversation_id": { "type": "string", "title": "发到哪个会话", "x-pick": "conversation", "description": "从最近的会话里选，或直接写 group:群号、private:QQ号。" },
          "text": { "type": "string", "title": "内容", "format": "textarea" }
        }
      }
    },
    { "name": "typing", "title": "显示「正在输入」", "description": "QQ 不支持，此动作什么也不做，仅为与其他平台的规则保持一致。" }
  ]
}

{
  "id": "magpie",
  "name": "Magpie",
  "version": "0.1.0",
  "category": "processor",
  "setup": true,
  "description": "经 Magpie 网关对话：模型、订阅和密钥都由 Magpie 管，这里只选用哪个模型。纯对话（不带工具），按会话保留上下文；也可以替规则的条件做判断。",
  "config_schema": {
    "type": "object",
    "required": [
      "model"
    ],
    "x-order": [
      "base_url",
      "api_key",
      "model",
      "system_prompt",
      "max_history"
    ],
    "properties": {
      "base_url": {
        "type": "string",
        "title": "Magpie 地址",
        "default": "http://127.0.0.1:3425",
        "description": "Magpie 网关的地址。Magpie 开在这台机器上时不用改。"
      },
      "api_key": {
        "type": "string",
        "title": "网关密钥（可选）",
        "format": "password",
        "description": "连接本机的 Magpie 不需要。连接别的机器上的 Magpie 时，填在那边用 magpie gateway-key add 建的密钥。"
      },
      "model": {
        "type": "string",
        "title": "模型",
        "x-pick": "option",
        "description": "Magpie 里的模型，写成 provider/model，也可以是路由组。可以从 Magpie 现有的模型里选。"
      },
      "system_prompt": {
        "type": "string",
        "title": "系统提示（可选）",
        "format": "textarea"
      },
      "max_history": {
        "type": "integer",
        "title": "保留的历史消息数",
        "default": 40
      }
    }
  },
  "actions": [
    {
      "name": "chat",
      "title": "对话",
      "description": "输出：text（回复）、session_id。",
      "params": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "x-order": [
          "prompt",
          "session_key",
          "system_prompt",
          "model",
          "new_session"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "title": "提示词",
            "format": "textarea",
            "default": "{{ payload.text }}",
            "description": "通常填 {{ payload.text }}，也可以在前后加上固定的说明。"
          },
          "session_key": {
            "type": "string",
            "title": "会话标识（可选）",
            "description": "相同标识续接同一段对话。留空则按消息所在的会话自动续接。"
          },
          "system_prompt": {
            "type": "string",
            "title": "附加系统提示（可选）",
            "format": "textarea"
          },
          "model": {
            "type": "string",
            "title": "换一个模型（可选）",
            "x-pick": "option",
            "description": "只在这个动作里用另一个模型，可以从 Magpie 现有的模型里选。留空用接入时选的。"
          },
          "new_session": {
            "type": "boolean",
            "title": "丢弃之前的对话，重新开始"
          }
        }
      }
    },
    {
      "name": "judge",
      "title": "判断",
      "description": "让模型从几个选项里选一个，不保留上下文。规则的条件节点用它来决定走哪条线。输出：choice（选中的选项）、text（模型的原话）。",
      "params": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "x-order": [
          "prompt",
          "choices",
          "system_prompt",
          "model"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "title": "要判断什么",
            "format": "textarea",
            "default": "{{ payload.text }}",
            "description": "把要判断的内容和判断标准写清楚，例如：这条消息是在报告故障吗？\n{{ payload.text }}"
          },
          "choices": {
            "type": "string",
            "title": "选项（可选）",
            "description": "逗号分隔。留空就是 yes / no。"
          },
          "system_prompt": {
            "type": "string",
            "title": "附加系统提示（可选）",
            "format": "textarea"
          },
          "model": {
            "type": "string",
            "title": "换一个模型（可选）",
            "x-pick": "option",
            "description": "只在这个动作里用另一个模型，可以从 Magpie 现有的模型里选。留空用接入时选的。"
          }
        }
      }
    }
  ],
  "protocol": 1,
  "command": [
    "./cat-plugin-magpie"
  ],
  "capabilities": [
    "action"
  ]
}

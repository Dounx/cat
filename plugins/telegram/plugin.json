{
  "id": "telegram",
  "name": "Telegram",
  "version": "0.1.0",
  "protocol": 1,
  "description": "通过 Bot 接收和发送 Telegram 消息。使用长轮询，不需要公网地址。",
  "command": ["./cat-plugin-telegram"],
  "capabilities": ["source", "action"],
  "setup": true,
  "config_schema": {
    "type": "object",
    "required": ["token"],
    "x-order": ["token", "api_base"],
    "properties": {
      "token": { "type": "string", "title": "Bot Token", "format": "password", "description": "在 @BotFather 创建 Bot 后获得。" },
      "api_base": { "type": "string", "title": "API 地址（可选）", "default": "https://api.telegram.org", "description": "使用自建 Bot API 服务或代理时修改。" }
    }
  },
  "events": [
    { "type": "message.created", "title": "收到消息" },
    { "type": "message.edited", "title": "消息被编辑" }
  ],
  "actions": [
    {
      "name": "reply",
      "title": "回复（原会话）",
      "description": "在触发事件所在的会话里回复。输出：message_id。",
      "params": {
        "type": "object",
        "required": ["text"],
        "x-order": ["text", "quote", "markdown"],
        "properties": {
          "text": { "type": "string", "title": "内容", "format": "textarea" },
          "quote": { "type": "boolean", "title": "引用原消息", "default": true },
          "markdown": { "type": "boolean", "title": "按 Markdown 渲染（失败时退回纯文本）" }
        }
      }
    },
    {
      "name": "send",
      "title": "发送到指定会话",
      "params": {
        "type": "object",
        "required": ["chat_id", "text"],
        "x-order": ["chat_id", "text", "markdown"],
        "properties": {
          "chat_id": { "type": "string", "title": "发到哪个会话", "x-pick": "conversation", "description": "从最近的会话里选，或直接写会话 ID。" },
          "text": { "type": "string", "title": "内容", "format": "textarea" },
          "markdown": { "type": "boolean", "title": "按 Markdown 渲染（失败时退回纯文本）" }
        }
      }
    },
    {
      "name": "typing",
      "title": "显示「正在输入」",
      "description": "在触发事件所在的会话里显示输入状态，适合放在耗时较长的 AI 步骤之前。"
    }
  ]
}

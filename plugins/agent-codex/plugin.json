{
  "id": "agent-codex",
  "name": "Codex",
  "version": "0.1.0",
  "category": "processor",
  "setup": true,
  "description": "把事件交给本机的 Codex CLI 处理，并按会话续接对话。",
  "config_schema": {
    "type": "object",
    "x-order": [
      "cwd",
      "sandbox",
      "model",
      "system_prompt",
      "allowed_actors",
      "allow_anyone",
      "bin"
    ],
    "properties": {
      "cwd": {
        "type": "string",
        "title": "工作目录",
        "description": "Codex 在这个目录里工作。留空使用 Cat 为它准备的空目录。"
      },
      "sandbox": {
        "type": "string",
        "title": "沙箱",
        "enum": [
          "read-only",
          "workspace-write",
          "danger-full-access"
        ], "x-enum-titles": ["只读（推荐）", "可以改工作目录里的文件", "不做任何限制（危险）"],
        "default": "read-only",
        "description": "「不做任何限制」只在你完全信任能触发它的人时使用。"
      },
      "model": {
        "type": "string",
        "title": "模型（可选）"
      },
      "system_prompt": {
        "type": "string",
        "title": "附加说明（可选）",
        "format": "textarea",
        "description": "在每段对话的第一条消息前附上。"
      },
      "allowed_actors": {
        "type": "string",
        "title": "允许谁来触发",
        "x-pick": "actor",
        "description": "只有这些人发的聊天消息能触发。从最近发过消息的人里选，或直接写发送者 ID，逗号分隔。"
      },
      "allow_anyone": {
        "type": "boolean",
        "title": "允许任何人触发（有风险：任何能给机器人发消息的人都能驱动它）"
      },
      "bin": {
        "type": "string",
        "title": "codex 命令路径（可选）",
        "description": "留空自动查找。"
      }
    }
  },
  "actions": [
    {
      "name": "chat",
      "title": "对话",
      "description": "输出：text（回复）、session_id。",
      "params": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "x-order": [
          "prompt",
          "session_key",
          "system_prompt",
          "new_session"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "title": "提示词",
            "format": "textarea",
            "default": "{{ payload.text }}",
            "description": "通常填 {{ payload.text }}，也可以在前后加上固定的说明。"
          },
          "session_key": {
            "type": "string",
            "title": "会话标识（可选）",
            "description": "相同标识续接同一段对话。留空则按消息所在的会话自动续接。"
          },
          "system_prompt": {
            "type": "string",
            "title": "附加系统提示（可选）",
            "format": "textarea"
          },
          "new_session": {
            "type": "boolean",
            "title": "丢弃之前的对话，重新开始"
          }
        }
      }
    }
  ],
  "protocol": 1,
  "command": [
    "./cat-plugin-agent-codex"
  ],
  "capabilities": [
    "action"
  ]
}
